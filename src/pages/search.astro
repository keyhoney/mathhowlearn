---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppPagination from '../components/ui/AppPagination.astro';
import problemMetadata from '../content/problems/_metadata.json';
import essayMetadata from '../content/essay-problems/_metadata.json';
import searchSynonyms from '../data/search-synonyms.json';

const problemMetaEntries = Object.entries(problemMetadata);
const hasEssayProblems = Object.keys(essayMetadata).length > 0;
const searchSubjects = Array.from(new Set(problemMetaEntries.map(([, meta]) => meta.subject).filter(Boolean))).sort((a, b) => String(a).localeCompare(String(b), 'ko'));
const searchConcepts = Array.from(new Set(problemMetaEntries.map(([, meta]) => meta.concept).filter(Boolean))).sort((a, b) => String(a).localeCompare(String(b), 'ko'));
const searchYears = Array.from(new Set(problemMetaEntries.map(([, meta]) => meta.year).filter(Boolean))).sort((a, b) => Number(b) - Number(a));

const problemSearchIndex = {
  problems: Object.fromEntries(
    problemMetaEntries.map(([id, meta]) => [id, meta.source]),
  ),
  essayProblems: Object.fromEntries(
    Object.entries(essayMetadata).map(([id, meta]) => [id, meta.source]),
  ),
  metaByUrl: Object.fromEntries(
    problemMetaEntries.map(([id, meta]) => [`/problems/${id}`, meta]),
  ),
};
---

<BaseLayout title="검색" description="GaeSaeGi Math 통합 검색">
  <section class="py-8">
    <h1 class="type-title">검색</h1>
    <p class="type-lead mt-3">
      수능·모평 수학 기출 문제를 검색할 수 있습니다.
    </p>

    <form id="search-form" class="book-card mt-6 border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900/90" role="search">
      <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto_180px]">
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="검색어를 입력하세요"
          enterkeyhint="search"
          class="gsg-filter-select"
          autocomplete="off"
        />
        <button type="submit" id="search-submit" class="gsg-btn-primary !min-h-0 w-full sm:w-auto">
          검색
        </button>
        <select id="search-sort" class="gsg-filter-select sm:col-start-3" aria-label="검색 결과 정렬">
          <option value="relevance">관련도</option>
          <option value="title">제목순</option>
        </select>
      </div>
      <div class="mt-3 flex flex-wrap gap-2" id="search-domain-tabs">
        <button type="button" data-domain="all" class="gsg-btn-primary !min-h-0 !px-4 !py-2 !text-sm">전체</button>
        <button type="button" data-domain="problems" class="gsg-btn-outline !min-h-0 !px-4 !py-2 !text-sm">수능·모평</button>
        {hasEssayProblems && (
          <button type="button" data-domain="essay-problems" class="gsg-btn-secondary !min-h-0 !px-4 !py-2 !text-sm">대학별 고사</button>
        )}
      </div>
      <div class="mt-3 grid gap-3 sm:grid-cols-3">
        <select id="search-subject" class="gsg-filter-select" aria-label="과목 필터">
          <option value="">전체 과목</option>
          {searchSubjects.map((subject) => <option value={String(subject)}>{String(subject)}</option>)}
        </select>
        <select id="search-concept" class="gsg-filter-select" aria-label="개념 필터">
          <option value="">전체 개념</option>
          {searchConcepts.map((concept) => <option value={String(concept)}>{String(concept)}</option>)}
        </select>
        <select id="search-year" class="gsg-filter-select" aria-label="연도 필터">
          <option value="">전체 연도</option>
          {searchYears.map((year) => <option value={String(year)}>{String(year)}</option>)}
        </select>
      </div>
    </form>

    <ul id="search-results" class="mt-6 grid gap-4"></ul>
    <p id="search-empty" class="type-lead mt-6">검색어를 입력해 주세요.</p>
    <AppPagination mode="client" basePath="/search" rootId="search-pagination" class="hidden" />
  </section>
</BaseLayout>

<script>
  import { buildSearchResultCardHtml } from '../lib/search-result-card';

  (window as Window & { howlearnBuildSearchCard?: typeof buildSearchResultCardHtml }).howlearnBuildSearchCard =
    buildSearchResultCardHtml;
</script>

<script is:inline define:vars={{ pagefindScript: `${import.meta.env.BASE_URL}pagefind/pagefind.js`, problemSearchIndex, searchSynonyms }}>
  const searchForm = document.getElementById('search-form');
  const input = document.getElementById('search-input');
  const sort = document.getElementById('search-sort');
  const subjectFilter = document.getElementById('search-subject');
  const conceptFilter = document.getElementById('search-concept');
  const yearFilter = document.getElementById('search-year');
  const domainTabs = document.getElementById('search-domain-tabs');
  const resultList = document.getElementById('search-results');
  const emptyEl = document.getElementById('search-empty');
  const paginationRoot = document.getElementById('search-pagination');
  let currentDomain = 'all';
  let pagefind = null;
  let pagefindLoadFailed = false;
  let allRecords = [];
  const perPageOptions = [12, 24, 48];

  function syncQueryToUrl(options = {}) {
    const url = new URL(window.location.href);
    const q = input?.value?.trim() || '';
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');

    if (sort?.value) url.searchParams.set('sort', sort.value);
    if (currentDomain !== 'all') url.searchParams.set('domain', currentDomain);
    else url.searchParams.delete('domain');
    for (const [key, el] of [
      ['subject', subjectFilter],
      ['concept', conceptFilter],
      ['year', yearFilter],
    ]) {
      const value = el?.value || '';
      if (value) url.searchParams.set(key, value);
      else url.searchParams.delete(key);
    }

    if (options.resetPage) {
      url.searchParams.set('page', '1');
    }

    window.history.replaceState({}, '', url);
  }

  function getPaginationParams() {
    const query = new URLSearchParams(window.location.search);
    const perPageRaw = Number.parseInt(query.get('perPage') ?? '12', 10);
    const perPage = perPageOptions.includes(perPageRaw) ? perPageRaw : 12;
    const pageRaw = Number.parseInt(query.get('page') ?? '1', 10);
    const page = Number.isFinite(pageRaw) && pageRaw > 0 ? pageRaw : 1;
    return { perPage, page };
  }

  function renderPagination() {
    if (!paginationRoot) return;
    const total = allRecords.length;
    if (total === 0) {
      paginationRoot.classList.add('hidden');
      return;
    }
    paginationRoot.classList.remove('hidden');
    const { perPage, page } = getPaginationParams();
    const totalPages = Math.max(1, Math.ceil(total / perPage));
    const currentPage = Math.min(page, totalPages);
    const render = () => {
      if (typeof window.__howlearnRenderAppPagination !== 'function') return false;
      window.__howlearnRenderAppPagination(paginationRoot, {
        basePath: '/search',
        currentPage,
        totalPages,
        perPage,
      });
      return true;
    };
    if (!render()) {
      let retries = 0;
      const timer = setInterval(() => {
        retries += 1;
        if (render() || retries >= 20) clearInterval(timer);
      }, 50);
    }
  }

  function mergeProblemCodeResult(query, records) {
    const raw = String(query || '').trim();
    if (!/^\d{8}$/.test(raw)) return records;
    const problemTitle = problemSearchIndex?.problems?.[raw];
    if (problemTitle) {
      const direct = { url: `/problems/${raw}`, meta: { title: problemTitle } };
      const rest = records.filter((item) => item.url !== direct.url);
      return [direct, ...rest];
    }
    const essayTitle = problemSearchIndex?.essayProblems?.[raw];
    if (essayTitle) {
      const direct = { url: `/essay-problems/${raw}`, meta: { title: essayTitle } };
      const rest = records.filter((item) => item.url !== direct.url);
      return [direct, ...rest];
    }
    return records;
  }

  function expandSearchQuery(query) {
    const raw = String(query || '').trim();
    const extras = searchSynonyms?.[raw] || [];
    return [raw, ...extras].filter(Boolean).join(' ');
  }

  function applyMetadataFilters(records) {
    const subject = subjectFilter?.value || '';
    const concept = conceptFilter?.value || '';
    const year = yearFilter?.value || '';
    if (!subject && !concept && !year) return records;
    return records.filter((item) => {
      const meta = problemSearchIndex?.metaByUrl?.[item.url || ''];
      if (!meta) return false;
      if (subject && String(meta.subject || '') !== subject) return false;
      if (concept && String(meta.concept || '') !== concept) return false;
      if (year && String(meta.year || '') !== year) return false;
      return true;
    });
  }

  async function ensurePagefind() {
    if (pagefindLoadFailed) return null;
    if (pagefind) return pagefind;
    try {
      const mod = await import(/* @vite-ignore */ pagefindScript);
      pagefind = mod;
      return pagefind;
    } catch (error) {
      pagefindLoadFailed = true;
      console.warn('Pagefind 로드 실패:', error);
      return null;
    }
  }

  function renderResults(records, totalCount, queryForTitleHighlight) {
    const buildCard = window.howlearnBuildSearchCard;
    const total = totalCount ?? records.length;
    if (total === 0) {
      if (resultList) resultList.innerHTML = '';
      if (emptyEl) emptyEl.textContent = '검색 결과가 없습니다.';
      if (paginationRoot) paginationRoot.classList.add('hidden');
      return;
    }
    const { perPage, page } = getPaginationParams();
    const totalPages = Math.max(1, Math.ceil(total / perPage));
    const currentPage = Math.min(page, totalPages);
    if (emptyEl) {
      emptyEl.textContent =
        totalPages > 1
          ? `검색 결과 ${total}건 (${currentPage}/${totalPages} 페이지)`
          : `검색 결과 ${total}건`;
    }
    if (!resultList) return;
    const q = String(queryForTitleHighlight || '').trim();
    resultList.innerHTML = records
      .map((item) => (buildCard ? buildCard(item, q) : ''))
      .join('');
    renderPagination();
  }

  function renderCurrentPage() {
    const { perPage, page } = getPaginationParams();
    const total = allRecords.length;
    const totalPages = Math.max(1, Math.ceil(total / perPage));
    const currentPage = Math.min(page, totalPages);
    const slice = allRecords.slice((currentPage - 1) * perPage, currentPage * perPage);
    const q = new URLSearchParams(window.location.search).get('q')?.trim() || input?.value?.trim() || '';
    renderResults(slice, total, q);
  }

  async function runSearch(options = {}) {
    const q = input?.value?.trim() || '';
    if (options.resetPage) syncQueryToUrl({ resetPage: true });
    else syncQueryToUrl();

    if (!q) {
      allRecords = [];
      if (resultList) resultList.innerHTML = '';
      if (emptyEl) emptyEl.textContent = '검색어를 입력해 주세요.';
      if (paginationRoot) paginationRoot.classList.add('hidden');
      return;
    }

    if (emptyEl) emptyEl.textContent = '검색 중…';

    const pf = await ensurePagefind();
    let records = [];
    if (pf) {
      const searched = await pf.search(expandSearchQuery(q));
      records = await Promise.all(searched.results.map((r) => r.data()));
    }

    if (currentDomain !== 'all') {
      records = records.filter((item) => {
        const url = item.url || '';
        if (currentDomain === 'problems') return url.startsWith('/problems/') && !url.startsWith('/problems/wrong-note') && !url.startsWith('/problems/bookmarks') && !url.startsWith('/problems/concept-frequency');
        if (currentDomain === 'essay-problems') return url.startsWith('/essay-problems/');
        return true;
      });
    }

    records = mergeProblemCodeResult(q, records);
    records = applyMetadataFilters(records);

    if (!pf && records.length === 0) {
      allRecords = [];
      if (resultList) resultList.innerHTML = '';
      if (emptyEl) emptyEl.textContent = '검색 인덱스가 없습니다. `npm run build` 후 `npm run preview`에서 검색을 사용할 수 있습니다.';
      if (paginationRoot) paginationRoot.classList.add('hidden');
      return;
    }

    if ((sort?.value || 'relevance') === 'title') {
      records = records.sort((a, b) => (a.meta.title || '').localeCompare(b.meta.title || '', 'ko'));
    }

    allRecords = records;
    renderCurrentPage();
  }

  function applyDomainTab(domain) {
    currentDomain = domain;
    domainTabs?.querySelectorAll('button').forEach((btn) => {
      btn.className = btn.getAttribute('data-domain') === domain ? 'app-btn-primary' : 'app-btn-secondary';
    });
  }

  searchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    runSearch({ resetPage: true });
  });

  input?.addEventListener('input', () => {
    runSearch({ resetPage: true });
  });

  sort?.addEventListener('change', () => {
    runSearch({ resetPage: true });
  });
  subjectFilter?.addEventListener('change', () => {
    runSearch({ resetPage: true });
  });
  conceptFilter?.addEventListener('change', () => {
    runSearch({ resetPage: true });
  });
  yearFilter?.addEventListener('change', () => {
    runSearch({ resetPage: true });
  });

  (function initFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q')?.trim() || '';
    const domain = params.get('domain') || 'all';
    const sortVal = params.get('sort');
    if (input && q) input.value = q;
    if (sort && sortVal) sort.value = sortVal;
    if (subjectFilter) subjectFilter.value = params.get('subject') || '';
    if (conceptFilter) conceptFilter.value = params.get('concept') || '';
    if (yearFilter) yearFilter.value = params.get('year') || '';
    applyDomainTab(domain);
    if (q) runSearch();
  })();

  domainTabs?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    const domain = target.getAttribute('data-domain') || 'all';
    applyDomainTab(domain);
    runSearch({ resetPage: true });
  });
</script>
