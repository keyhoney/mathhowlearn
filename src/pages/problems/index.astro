---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  buildProblemSubjectChapterTree,
  getPublishedProblems,
} from '../../lib/content-utils';
import AppPagination from '../../components/ui/AppPagination.astro';
import DifficultyStars from '../../components/DifficultyStars.astro';
import { getExamTypeBadgeClass } from '../../lib/exam-type-badge';
import { STORAGE_KEYS } from '../../lib/storage-keys';

const allProblems = await getPublishedProblems();
const monthPriority = new Map<number, number>([
  [11, 0], // 수능
  [9, 1],  // 9월 모평
  [6, 2],  // 6월 모평
]);

function extractQuestionNumber(source: string): number {
  const matched = source.match(/(\d+)\s*번(?!.*\d+\s*번)/);
  return matched ? Number.parseInt(matched[1] ?? '', 10) : Number.POSITIVE_INFINITY;
}

const sortedProblems = [...allProblems].sort((a, b) => {
  // 1) 최신 연도 우선
  if (a.data.year !== b.data.year) return b.data.year - a.data.year;

  // 2) 수능(11월) -> 9월 -> 6월 우선, 그 외 월은 뒤로
  const aMonthOrder = monthPriority.get(a.data.month) ?? 999;
  const bMonthOrder = monthPriority.get(b.data.month) ?? 999;
  if (aMonthOrder !== bMonthOrder) return aMonthOrder - bMonthOrder;
  if (a.data.month !== b.data.month) return b.data.month - a.data.month;

  // 3) 문항 번호 오름차순, 동일하면 source 텍스트 오름차순
  const aQ = extractQuestionNumber(a.data.source);
  const bQ = extractQuestionNumber(b.data.source);
  if (aQ !== bQ) return aQ - bQ;
  return a.data.source.localeCompare(b.data.source, 'ko');
});

const subjectChapterTree = buildProblemSubjectChapterTree(allProblems);
const examTypes = Array.from(new Set(sortedProblems.map((p) => p.data.examType)));
const subjects = Object.keys(subjectChapterTree);
const years = Array.from(new Set(sortedProblems.map((p) => p.data.year))).sort((a, b) => b - a);
const months = Array.from(new Set(sortedProblems.map((p) => p.data.month))).sort((a, b) => a - b);
---

<BaseLayout title="수능 기출 문제" description="수능/모의평가 기출 문제 및 단계별 힌트·해설">
  <section class="pb-12">
    <div class="hub-atmosphere mb-6 flex flex-wrap items-end justify-between gap-3 rounded-2xl border border-indigo-500/10 bg-[var(--surface-1)] p-6 shadow-[var(--shadow-brand)]" id="focus-mode">
      <div>
        <h1 class="type-title brand-gradient-text">수능 기출 문제</h1>
        <p class="type-lead mt-2 max-w-2xl">
          기본은 과목·단원·개념으로 고르고, 필요하면 시험 연·월로 바꿀 수 있습니다. 단계별 힌트와 함께 풀어보세요.
          <a href="/problems/concept-frequency" class="ml-1 font-medium text-indigo-600 hover:underline dark:text-indigo-400">개념별 출제 경향</a>도 확인할 수 있습니다.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="type-caption chrome-muted">전체 {sortedProblems.length}</span>
        <span class="type-caption chrome-muted">표시 <span data-filtered-count>{sortedProblems.length}</span></span>
      </div>
    </div>

    <form class="mt-6 rounded-xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-700/80 dark:bg-slate-900/50" data-problem-filter-form>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">과목</span>
          <select name="subject" id="filter-subject" class="gsg-filter-select">
            <option value="">전체 과목</option>
            {subjects.map((v) => <option value={v}>{v}</option>)}
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">대단원</span>
          <select name="chapter" id="filter-chapter" class="gsg-filter-select">
            <option value="">과목을 먼저 선택</option>
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">중단원</span>
          <select name="subChapter" id="filter-sub-chapter" class="gsg-filter-select">
            <option value="">단원을 먼저 선택</option>
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">개념</span>
          <select name="concept" id="filter-concept" class="gsg-filter-select">
            <option value="">중단원을 먼저 선택</option>
          </select>
        </label>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">시험 유형</span>
          <select name="examType" class="gsg-filter-select">
            <option value="">전체 시험</option>
            {examTypes.map((v) => <option value={v}>{v}</option>)}
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">연도</span>
          <select name="year" class="gsg-filter-select">
            <option value="">전체 연도</option>
            {years.map((v) => <option value={String(v)}>{v}</option>)}
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">월</span>
          <select name="month" class="gsg-filter-select">
            <option value="">전체 월</option>
            {months.map((v) => <option value={String(v)}>{v}월</option>)}
          </select>
        </label>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">풀이 상태</span>
          <select name="status" class="gsg-filter-select">
            <option value="all">전체 상태</option>
            <option value="none">미시작</option>
            <option value="progress">진행 중</option>
            <option value="done">완료</option>
          </select>
        </label>
        <label class="app-filter-check self-end">
          <input type="checkbox" name="wrongOnly" value="1" class="h-4 w-4 accent-indigo-600" />
          오답만
        </label>
        <label class="app-filter-check self-end">
          <input type="checkbox" name="bookmarkedOnly" value="1" class="h-4 w-4 accent-indigo-600" />
          스크랩만
        </label>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-[var(--card-border)] pt-4">
        <button class="gsg-btn-primary !min-h-0 !px-4 !py-2 !text-sm" type="submit">적용</button>
        <a href="/problems" class="gsg-btn-outline !min-h-0 !px-4 !py-2 !text-sm">초기화</a>
      </div>
    </form>

    <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sortedProblems.map((p) => (
          <li class="h-full">
            <a
              href={`/problems/${p.id}`}
              data-preserve-list-state-link
              data-problem-card
              data-problem-id={p.id}
              data-exam-type={p.data.examType}
              data-year={p.data.year}
              data-month={p.data.month}
              data-subject={p.data.subject}
              data-chapter={p.data.chapter}
              data-sub-chapter={p.data.subChapter}
              data-concept={p.data.concept}
              class="group flex h-full flex-col book-card border border-indigo-500/10 bg-[var(--surface-1)] transition-colors hover:bg-[var(--surface-2)] dark:border-indigo-500/10"
              title={`${p.data.subject} · ${p.data.chapter} · ${p.data.concept}`}
            >
              <div class="flex flex-wrap items-start justify-between gap-2">
                <h2 class="type-heading group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                  {p.data.source}
                </h2>
                <div class="flex shrink-0 flex-wrap items-center justify-end gap-1.5">
                  <span class="type-caption rounded-full px-2 py-0.5 font-medium" data-problem-state-badge></span>
                  <span class="type-caption rounded-full bg-slate-100 px-2 py-0.5 font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                    {p.data.year}.{String(p.data.month).padStart(2, '0')}
                  </span>
                </div>
              </div>
              <p class="type-caption chrome-muted mt-2">
                {p.data.subject} · {p.data.chapter} · {p.data.concept}
              </p>
              <p class="type-caption chrome-muted mt-1">{p.data.examType}</p>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <DifficultyStars value={p.data.difficulty ?? 3} />
              </div>
              <p class="type-caption mt-2 text-[var(--fg-muted)]" data-problem-state-meta>진행 정보 불러오는 중…</p>
              <span class="sr-only" data-problem-state></span>
              <div class="mt-auto flex items-center justify-end pt-3">
                <span class="flex h-10 w-10 items-center justify-center rounded bg-slate-50 text-slate-400 transition-colors group-hover:bg-indigo-50 group-hover:text-indigo-600 dark:bg-slate-800/80 dark:group-hover:bg-indigo-950/50 dark:text-slate-500 dark:group-hover:text-indigo-400">
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/></svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <AppPagination mode="client" basePath="/problems" rootId="problems-pagination" />
  </section>
</BaseLayout>

<script
  id="problem-list-config"
  type="application/json"
  set:html={JSON.stringify({ subjectChapterTree, storageKeys: STORAGE_KEYS })}
/>
<script>
  import { initProblemListPage } from '../../lib/client/problem-list-page';

  const configEl = document.getElementById('problem-list-config');
  if (configEl?.textContent) {
    initProblemListPage(JSON.parse(configEl.textContent));
  }
</script>
