---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const [problems, essayProblems] = await Promise.all([
  getCollection('problems'),
  getCollection('essay-problems'),
]);

const candidates = [
  ...problems.map((p) => ({
    id: p.id,
    href: `/problems/${p.id}`,
    title: p.data.source,
    meta: `${p.data.year}년 ${p.data.month}월 · ${p.data.examType}`,
    type: 'problem',
    typeLabel: '기출',
    year: p.data.year,
    month: p.data.month,
    examType: p.data.examType,
    subject: p.data.subject,
    chapter: p.data.chapter,
    subChapter: p.data.subChapter,
    concept: p.data.concept,
    difficulty: p.data.difficulty,
  })),
  ...essayProblems.map((p) => ({
    id: p.id,
    href: `/essay-problems/${p.id}`,
    title: p.data.source,
    meta: `${p.data.examYear ?? p.data.year}년 · ${p.data.university}`,
    type: 'essay',
    typeLabel: '논술',
    year: p.data.examYear ?? p.data.year,
    month: 0,
    examType: p.data.examType,
    subject: '논술',
    chapter: p.data.university,
    subChapter: '대학별',
    concept: '대학별 고사',
    difficulty: p.data.difficulty,
  })),
];
---

<BaseLayout title="스크랩 모음" description="북마크한 문제 복습 페이지">
  <section class="py-8 sm:py-10">
    <div class="book-card--compact mb-6 flex flex-wrap items-end justify-between gap-3 border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900/90">
      <div>
        <h1 class="type-article-title">스크랩 모음</h1>
        <p class="type-lead mt-2">저장 시각(최근순) 기준으로 정렬됩니다.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="type-overline rounded border border-slate-200 bg-slate-100 px-2 py-0.5 normal-case tracking-normal font-bold text-slate-600 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400" id="bookmark-total">0건</span>
        <button type="button" class="gsg-btn-outline !min-h-0 !px-4 !py-2 !text-sm" id="bookmark-clear">전체 비우기</button>
      </div>
    </div>

    <div class="hub-feature-card grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">검색어</span>
          <input id="bookmark-keyword" type="search" placeholder="키워드 검색" class="gsg-filter-select !py-2" />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">유형</span>
          <select id="bookmark-type" class="gsg-filter-select">
            <option value="all">전체 유형</option>
            <option value="problem">기출</option>
            <option value="essay">논술</option>
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">정렬</span>
          <select id="bookmark-sort" class="gsg-filter-select">
            <option value="recent">최근순</option>
            <option value="name">이름순</option>
            <option value="attempts">횟수순</option>
          </select>
        </label>
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="bookmark-list" aria-live="polite"></ul>
    <div
      class="mt-8 hidden rounded-xl border-2 border-dashed border-[var(--card-border)] bg-[var(--surface-2)] px-6 py-10 text-center sm:px-10"
      id="bookmark-empty"
    >
      <p class="text-sm font-medium text-[var(--fg)]">저장된 스크랩이 없습니다.</p>
      <p class="mt-2 text-sm text-[var(--fg-muted)] leading-relaxed">
        문제 상세에서 스크랩 버튼을 누르면 이 목록에 표시됩니다.
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ candidates }}>
  const listEl = document.getElementById('bookmark-list');
  const emptyEl = document.getElementById('bookmark-empty');
  const totalEl = document.getElementById('bookmark-total');
  const clearBtn = document.getElementById('bookmark-clear');
  const keywordInput = document.getElementById('bookmark-keyword');
  const typeSelect = document.getElementById('bookmark-type');
  const sortSelect = document.getElementById('bookmark-sort');
  const byId = new Map(candidates.map((v) => [v.id, v]));

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function parse(raw, fallback) {
    try {
      return JSON.parse(raw);
    } catch {
      return fallback;
    }
  }

  function readRows() {
    const raw = localStorage.getItem('howlearn-bookmark');
    const store = raw ? parse(raw, { v: 1, byId: {} }) : { v: 1, byId: {} };
    const wrongRaw = localStorage.getItem('howlearn-wrong-note');
    const wrongStore = wrongRaw ? parse(wrongRaw, { v: 1, byId: {} }) : { v: 1, byId: {} };
    return Object.entries(store.byId || {})
      .map(([id, value]) => ({
        id,
        ts: value?.ts ?? 0,
        attempts: wrongStore.byId?.[id]?.entries?.length ?? 0,
      }))
      .filter((row) => row.ts > 0);
  }

  function render() {
    const keyword = String(keywordInput?.value || '').trim().toLowerCase();
    const selectedType = String(typeSelect?.value || 'all');
    const sortBy = String(sortSelect?.value || 'recent');

    let rows = readRows()
      .map((row) => {
        const item = byId.get(row.id);
        return { ...row, item };
      })
      .filter((row) => row.item);

    if (selectedType !== 'all') {
      rows = rows.filter((row) => row.item.type === selectedType);
    }
    if (keyword) {
      rows = rows.filter((row) => {
        const target = `${row.item.title} ${row.item.meta} ${row.item.chapter} ${row.item.subChapter} ${row.item.concept}`.toLowerCase();
        return target.includes(keyword);
      });
    }
    rows.sort((a, b) => {
      if (sortBy === 'name') return a.item.title.localeCompare(b.item.title, 'ko');
      if (sortBy === 'attempts') return b.attempts - a.attempts || b.ts - a.ts;
      return b.ts - a.ts;
    });

    if (totalEl) totalEl.textContent = `${rows.length}건`;

    if (!listEl) return;
    if (rows.length === 0) {
      listEl.innerHTML = '';
      emptyEl?.classList.remove('hidden');
      return;
    }

    emptyEl?.classList.add('hidden');

    listEl.innerHTML = rows
      .map((row) => {
        const it = row.item;
        const when = new Date(row.ts).toLocaleString();
        const meta = it.meta || `${it.year}년`;
        const extra = row.attempts > 0 ? ` · 오답 ${row.attempts}회` : '';
        return `
          <li class="h-full">
            <a href="${it.href}" title="스크랩 · ${escapeHtml(when)}${extra}" class="group flex h-full flex-col book-card border border-slate-200 bg-white transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900/90 dark:hover:bg-slate-800/50">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <h2 class="type-heading group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">${escapeHtml(it.title)}</h2>
                <span class="type-caption shrink-0 rounded border border-indigo-200 bg-indigo-50 px-2 py-0.5 font-medium text-indigo-700 dark:border-indigo-800/50 dark:bg-indigo-950/45 dark:text-indigo-200">스크랩</span>
              </div>
              <p class="type-caption chrome-muted mt-2">${escapeHtml(meta)}</p>
              <div class="mt-auto flex items-center justify-end pt-4">
                <span class="flex h-10 w-10 items-center justify-center rounded bg-slate-50 text-slate-400 transition-colors group-hover:bg-indigo-50 group-hover:text-indigo-600 dark:bg-slate-800/80 dark:group-hover:bg-indigo-950/50 dark:text-slate-500 dark:group-hover:text-indigo-400">
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/></svg>
                </span>
              </div>
            </a>
          </li>
        `;
      })
      .join('');
  }

  clearBtn?.addEventListener('click', () => {
    localStorage.removeItem('howlearn-bookmark');
    render();
  });
  keywordInput?.addEventListener('input', render);
  typeSelect?.addEventListener('change', render);
  sortSelect?.addEventListener('change', render);

  render();
</script>
