---
import MathLayout from '../../../layouts/MathLayout.astro';
import { getPublishedProblems } from '../../../lib/content-utils';
import { buildMockExamSessions } from '../../../lib/exam-session';

const allProblems = await getPublishedProblems();
const sessions = buildMockExamSessions(allProblems);
---

<MathLayout title="모의 수능" description="수능 수학 30문항 100분 실전 모의고사">
  <section class="max-w-3xl mx-auto pb-12">
    <header class="hub-atmosphere mb-8 rounded-2xl border border-indigo-500/10 bg-[var(--surface-1)] p-6 shadow-[var(--shadow-brand)]">
      <h1 class="type-title brand-gradient-text">모의 수능</h1>
      <p class="type-lead mt-3 max-w-2xl">
        실제 시험과 같이 30문항을 100분 안에 풀고, 종료 후 원점수·표준점수·등급 컷을 확인합니다.
        정답은 시험 종료 전까지 공개되지 않습니다.
      </p>
    </header>

    <div class="space-y-3">
      {
        sessions.map((session) => (
          <a
            href={`/problems/mock-exam/${session.sessionId}`}
            class="book-card flex flex-wrap items-center justify-between gap-3 border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md dark:border-slate-700 dark:bg-slate-900/90"
          >
            <div>
              <h2 class="type-subhead m-0">{session.label}</h2>
              <p class="type-caption chrome-muted mt-1">30문항 · 100분 · 확률과 통계</p>
            </div>
            <span class="gsg-btn-primary shrink-0 px-4 py-2 text-sm">시험 시작</span>
          </a>
        ))
      }
    </div>

    {
      sessions.length === 0 ? (
        <p class="type-caption chrome-muted mt-6">등록된 모의고사 회차가 없습니다.</p>
      ) : null
    }
  </section>
</MathLayout>
