---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { STORAGE_KEYS } from '../../lib/storage-keys';

const [problems, essayProblems] = await Promise.all([
  getCollection('problems'),
  getCollection('essay-problems'),
]);

const candidates = [
  ...problems.map((p) => ({
    id: p.id,
    href: `/problems/${p.id}`,
    title: p.data.source,
    meta: `${p.data.year}년 ${p.data.month}월 · ${p.data.examType}`,
    type: 'problem',
    typeLabel: '기출',
    year: p.data.year,
    month: p.data.month,
    examType: p.data.examType,
    subject: p.data.subject,
    chapter: p.data.chapter,
    subChapter: p.data.subChapter,
    concept: p.data.concept,
    difficulty: p.data.difficulty,
  })),
  ...essayProblems.map((p) => ({
    id: p.id,
    href: `/essay-problems/${p.id}`,
    title: p.data.source,
    meta: `${p.data.examYear ?? p.data.year}년 · ${p.data.university}`,
    type: 'essay',
    typeLabel: '논술',
    year: p.data.examYear ?? p.data.year,
    month: 0,
    examType: p.data.examType,
    subject: '논술',
    chapter: p.data.university,
    subChapter: '대학별',
    concept: '대학별 고사',
    difficulty: p.data.difficulty,
  })),
];
---

<BaseLayout title="오답 노트" description="로컬 오답 기록 기반 복습 페이지">
  <section class="py-8 sm:py-10">
    <div class="book-card--compact mb-6 flex flex-wrap items-end justify-between gap-3 border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900/90">
      <div>
        <h1 class="type-article-title">오답 노트</h1>
        <p class="type-lead mt-2">최근 오답순으로 정렬된 개인 복습 목록입니다.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="type-overline rounded border border-slate-200 bg-slate-100 px-2 py-0.5 normal-case tracking-normal font-bold text-slate-600 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400" id="wrong-note-total">0건</span>
        <button type="button" class="gsg-btn-outline !min-h-0 !px-4 !py-2 !text-sm" id="wrong-note-clear">전체 비우기</button>
      </div>
    </div>

    <div class="hub-feature-card">
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-lg border border-slate-200/80 bg-slate-50/50 p-3 dark:border-slate-700 dark:bg-slate-900/40">
            <p class="type-caption chrome-muted">최근 7일 Top 개념</p>
            <p class="mt-1 type-subhead" id="wrong-note-top-concepts">-</p>
          </div>
          <div class="rounded-lg border border-slate-200/80 bg-slate-50/50 p-3 dark:border-slate-700 dark:bg-slate-900/40">
            <p class="type-caption chrome-muted">반복 오답 문제</p>
            <p class="mt-1 type-subhead" id="wrong-note-repeat-count">0문항</p>
          </div>
          <div class="rounded-lg border border-slate-200/80 bg-slate-50/50 p-3 dark:border-slate-700 dark:bg-slate-900/40">
            <p class="type-caption chrome-muted">정답 전환율</p>
            <p class="mt-1 type-subhead" id="wrong-note-conversion-rate">0%</p>
          </div>
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <label class="flex flex-col gap-1.5">
            <span class="type-caption chrome-muted">검색어</span>
            <input id="wrong-note-keyword" type="search" placeholder="키워드 검색" class="gsg-filter-select !py-2" />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="type-caption chrome-muted">유형</span>
            <select id="wrong-note-type" class="gsg-filter-select">
              <option value="all">전체 유형</option>
              <option value="problem">기출</option>
              <option value="essay">논술</option>
            </select>
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="type-caption chrome-muted">정렬</span>
            <select id="wrong-note-sort" class="gsg-filter-select">
              <option value="recent">최근순</option>
              <option value="name">이름순</option>
              <option value="attempts">횟수순</option>
            </select>
          </label>
        </div>
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="wrong-note-list" aria-live="polite"></ul>
    <div
      class="mt-8 hidden rounded-xl border-2 border-dashed border-[var(--card-border)] bg-[var(--surface-2)] px-6 py-10 text-center sm:px-10"
      id="wrong-note-empty"
    >
      <p class="text-sm font-medium text-[var(--fg)]">아직 저장된 오답이 없습니다.</p>
      <p class="mt-2 text-sm text-[var(--fg-muted)] leading-relaxed">
        문제를 풀고 오답이 발생하면 자동으로 오답 노트에 쌓입니다.
      </p>
    </div>
  </section>
</BaseLayout>

<script
  id="wrong-note-config"
  type="application/json"
  set:html={JSON.stringify({ candidates, storageKeys: STORAGE_KEYS })}
/>
<script>
  import { initWrongNotePage } from '../../lib/client/wrong-note-page';

  const configEl = document.getElementById('wrong-note-config');
  if (configEl?.textContent) {
    initWrongNotePage(JSON.parse(configEl.textContent));
  }
</script>
