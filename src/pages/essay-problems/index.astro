---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getPublishedEssayProblems,
} from '../../lib/content-utils';
import AppPagination from '../../components/ui/AppPagination.astro';
import { STORAGE_KEYS } from '../../lib/storage-keys';

const allProblems = await getPublishedEssayProblems();
const universities = Array.from(new Set(allProblems.map((p) => p.data.university)));
const years = Array.from(new Set(allProblems.map((p) => p.data.year))).sort((a, b) => b - a);
---

<BaseLayout title="대학별 고사 수학 문제" description="대학별 고사 대비 논술 수학 문제 및 실전 학습 자료">
  <section class="pb-12">
    <div class="hub-atmosphere mb-6 flex flex-wrap items-end justify-between gap-3 rounded-2xl border border-indigo-500/10 bg-[var(--surface-1)] p-6 shadow-[var(--shadow-brand)]">
      <div>
        <h1 class="type-title brand-gradient-text">논술 기출 문제</h1>
        <p class="type-lead mt-2">대학별 고사 수학 문제를 단계별 힌트와 함께 풀어보세요.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="type-caption chrome-muted">전체 {allProblems.length}</span>
        <span class="type-caption chrome-muted">표시 <span data-filtered-count>{allProblems.length}</span></span>
      </div>
    </div>

    <form class="mt-6 rounded-xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-700/80 dark:bg-slate-900/50" data-essay-filter-form>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">대학</span>
          <select name="university" class="gsg-filter-select">
            <option value="">전체 대학</option>
            {universities.map((v) => <option value={v}>{v}</option>)}
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">연도</span>
          <select name="year" class="gsg-filter-select">
            <option value="">전체 연도</option>
            {years.map((v) => <option value={String(v)}>{v}</option>)}
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="type-caption chrome-muted">풀이 상태</span>
          <select name="status" class="gsg-filter-select">
            <option value="all">전체 상태</option>
            <option value="none">미시작</option>
            <option value="done">완료</option>
          </select>
        </label>
        <div class="flex flex-wrap items-end gap-2">
          <button class="gsg-btn-primary !min-h-0 !px-4 !py-2 !text-sm" type="submit">적용</button>
          <a href="/essay-problems" class="gsg-btn-outline !min-h-0 !px-4 !py-2 !text-sm">초기화</a>
        </div>
      </div>
      <label class="mt-3 flex items-center gap-2 text-sm chrome-muted">
        <input type="checkbox" name="bookmarked" value="1" class="h-4 w-4 accent-indigo-600" />
        스크랩한 문제만 보기
      </label>
    </form>

    <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        allProblems.map((p) => (
          <li class="h-full">
            <a
              href={`/essay-problems/${p.id}`}
              data-preserve-list-state-link
              data-problem-card
              data-problem-id={p.id}
              data-university={p.data.university}
              data-year={p.data.year}
              class="group flex h-full flex-col book-card border border-indigo-500/10 bg-[var(--surface-1)] transition-colors hover:bg-[var(--surface-2)] dark:border-indigo-500/10"
            >
              <div class="flex flex-wrap items-start justify-between gap-2">
                <h2 class="type-heading group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                  {p.data.source}
                </h2>
                <div class="flex shrink-0 flex-wrap items-center justify-end gap-1.5">
                  <span class="type-caption rounded-full px-2 py-0.5 font-medium" data-problem-state-badge></span>
                  <span class="type-caption max-w-[8rem] truncate rounded-full bg-slate-100 px-2 py-0.5 font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                    {p.data.university}
                  </span>
                </div>
              </div>
              <p class="type-caption chrome-muted mt-2">
                {p.data.examYear ?? p.data.year}년
              </p>
              <p class="type-caption mt-2 text-[var(--fg-muted)]" data-problem-state-meta>진행 정보 불러오는 중…</p>
              <span class="sr-only" data-problem-state></span>
              <div class="mt-auto flex items-center justify-end pt-3">
                <span class="flex h-10 w-10 items-center justify-center rounded bg-slate-50 text-slate-400 transition-colors group-hover:bg-indigo-50 group-hover:text-indigo-600 dark:bg-slate-800/80 dark:group-hover:bg-indigo-950/50 dark:text-slate-500 dark:group-hover:text-indigo-400">
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/></svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <AppPagination mode="client" basePath="/essay-problems" rootId="essay-problems-pagination" />
  </section>
</BaseLayout>

<script is:inline define:vars={{ storageKeys: STORAGE_KEYS }}>
  (() => {
  return;
  function getProgressDetail(raw) {
    if (!raw) return { status: 'none', hintRevealedCount: 0, solutionRevealed: false, lastSeenAt: 0 };
    if (typeof raw === 'string') return { status: raw, hintRevealedCount: 0, solutionRevealed: false, lastSeenAt: 0 };
    return {
      status: raw.status || 'none',
      hintRevealedCount: Number(raw.hintRevealedCount || 0),
      solutionRevealed: Boolean(raw.solutionRevealed),
      lastSeenAt: Number(raw.lastSeenAt || 0),
    };
  }

  const query = new URLSearchParams(window.location.search);
  const statusFilter = query.get('status') ?? 'all';
  const bookmarkedOnly = query.get('bookmarked') === '1';
  const university = query.get('university') ?? '';
  const year = query.get('year') ?? '';
  const perPageRaw = Number.parseInt(query.get('perPage') ?? '12', 10);
  const perPageOptions = [12, 24, 48];
  const perPage = perPageOptions.includes(perPageRaw) ? perPageRaw : 12;
  const pageRaw = Number.parseInt(query.get('page') ?? '1', 10);
  const page = Number.isFinite(pageRaw) && pageRaw > 0 ? pageRaw : 1;
  const form = document.querySelector('[data-essay-filter-form]');
  const filteredCountEl = document.querySelector('[data-filtered-count]');
  const paginationRoot = document.getElementById('essay-problems-pagination');
  if (!form || !filteredCountEl || !paginationRoot) return;
  form.querySelector('[name="university"]').value = university;
  form.querySelector('[name="year"]').value = year;
  form.querySelector('[name="status"]').value = statusFilter;
  form.querySelector('[name="bookmarked"]').checked = bookmarkedOnly;
  form.addEventListener('submit', () => {
    const pageField = document.createElement('input');
    pageField.type = 'hidden';
    pageField.name = 'page';
    pageField.value = '1';
    form.appendChild(pageField);
  });

  const progress = JSON.parse(localStorage.getItem(storageKeys.PROBLEM_PROGRESS) || '{"byId":{}}');
  const bookmarks = JSON.parse(localStorage.getItem(storageKeys.BOOKMARK) || '{"byId":{}}');
  const currentQuery = window.location.search;
  if (currentQuery) {
    document.querySelectorAll('a[data-preserve-list-state-link]').forEach((anchor) => {
      const href = anchor.getAttribute('href');
      if (!href || href.includes('?')) return;
      anchor.setAttribute('href', `${href}${currentQuery}`);
    });
  }
  const visibleItems = [];
  document.querySelectorAll('[data-problem-card]').forEach((el) => {
    const id = el.getAttribute('data-problem-id') || '';
    const detail = getProgressDetail(progress.byId?.[id]);
    const valueStatus = detail.status;
    const bookmarked = Boolean(bookmarks.byId?.[id]);
    const stateEl = el.querySelector('[data-problem-state]');
    const metaEl = el.querySelector('[data-problem-state-meta]');
    const stateBadgeEl = el.querySelector('[data-problem-state-badge]');
    const progressBadgeClass = {
      none: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400',
      progress: 'bg-amber-50 text-amber-800 dark:bg-amber-950/45 dark:text-amber-200',
      done: 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200',
    };
    const progressLabel = { none: '미시작', progress: '진행 중', done: '완료' };
    if (stateBadgeEl) {
      stateBadgeEl.className = `type-caption rounded-full px-2 py-0.5 font-medium ${progressBadgeClass[valueStatus] || progressBadgeClass.none}`;
      stateBadgeEl.textContent = progressLabel[valueStatus] || progressLabel.none;
    }
    const metaParts = [progressLabel[valueStatus] || progressLabel.none];
    if (detail.lastSeenAt > 0) {
      const d = new Date(detail.lastSeenAt);
      metaParts.push(`마지막 ${d.getFullYear()}.${d.getMonth() + 1}.${d.getDate()}`);
    }
    if (detail.hintRevealedCount > 0) metaParts.push(`힌트 ${detail.hintRevealedCount}개`);
    if (detail.solutionRevealed) metaParts.push('풀이 열람');
    if (bookmarked) metaParts.push('스크랩');
    if (metaEl) metaEl.textContent = metaParts.join(' · ');
    if (stateEl) stateEl.textContent = metaParts.join(' · ');
    if (metaParts.length > 0) el.setAttribute('title', metaParts.join(' · '));

    const mismatchServerFilter =
      (university && (el.getAttribute('data-university') || '') !== university) ||
      (year && (el.getAttribute('data-year') || '') !== year);
    const mismatchStatus = statusFilter !== 'all' && valueStatus !== statusFilter;
    const mismatchBookmark = bookmarkedOnly && !bookmarked;
    const li = el.parentElement;
    if (!li) return;
    const matched = !(mismatchServerFilter || mismatchStatus || mismatchBookmark);
    li.classList.toggle('hidden', !matched);
    if (matched) visibleItems.push(li);
  });
  filteredCountEl.textContent = String(visibleItems.length);
  const totalPages = Math.max(1, Math.ceil(visibleItems.length / perPage));
  const currentPage = Math.min(page, totalPages);
  visibleItems.forEach((li, idx) => {
    const show = idx >= (currentPage - 1) * perPage && idx < currentPage * perPage;
    li.classList.toggle('hidden', !show);
  });
  const renderPagination = () => {
    if (typeof window.__howlearnRenderAppPagination !== 'function') return false;
    window.__howlearnRenderAppPagination(paginationRoot, {
      basePath: '/essay-problems',
      currentPage,
      totalPages,
      perPage,
    });
    return true;
  };

  if (!renderPagination()) {
    let retries = 0;
    const maxRetries = 20;
    const tick = () => {
      if (renderPagination()) return;
      retries += 1;
      if (retries < maxRetries) window.setTimeout(tick, 50);
    };
    tick();
  }
  })();
</script>
<script
  id="essay-problem-list-config"
  type="application/json"
  set:html={JSON.stringify({ storageKeys: STORAGE_KEYS })}
/>
<script>
  import { initEssayProblemListPage } from '../../lib/client/problem-list-page';

  const configEl = document.getElementById('essay-problem-list-config');
  if (configEl?.textContent) {
    initEssayProblemListPage(JSON.parse(configEl.textContent));
  }
</script>
