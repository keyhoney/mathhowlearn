---
import AuthGoogleButton from './AuthGoogleButton.astro';

interface Props {
  mode: 'login' | 'signup';
  title: string;
  description: string;
  emailSectionTitle: string;
  emailSectionHint?: string;
  submitLabel: string;
  googleSectionTitle: string;
  googleSectionHint: string;
  googleLabel: string;
  switchPrompt: string;
  switchHref: string;
  switchLabel: string;
  message: string;
}

const {
  mode,
  title,
  description,
  emailSectionTitle,
  emailSectionHint,
  submitLabel,
  googleSectionTitle,
  googleSectionHint,
  googleLabel,
  switchPrompt,
  switchHref,
  switchLabel,
  message,
} = Astro.props;

const isSignup = mode === 'signup';
---

<section class="mx-auto max-w-lg py-8 sm:py-10">
  <article
    class="book-card border border-[var(--card-border)] bg-[var(--surface-1)] shadow-sm"
    data-auth-page
    data-auth-mode={mode}
  >
    <p class="type-overline chrome-muted">GaeSaeGi Math</p>
    <h1 class="type-title mt-2">{title}</h1>
    <p class="type-caption chrome-muted mt-2">{description}</p>

    <section class="mt-6 rounded-xl border border-[var(--card-border)] bg-[var(--surface-2)] p-4 sm:p-5">
      <h2 class="text-sm font-semibold text-[var(--fg)]">{emailSectionTitle}</h2>
      {emailSectionHint && <p class="mt-1 text-xs text-[var(--fg-muted)]">{emailSectionHint}</p>}
      <div class="mt-4 space-y-3">
        <label class="block">
          <span class="mb-1 block text-sm font-medium text-[var(--fg)]">이메일</span>
          <input
            type="email"
            autocomplete="email"
            class="app-input w-full"
            placeholder="you@example.com"
            data-auth-email
            required
          />
        </label>
        <label class="block">
          <span class="mb-1 block text-sm font-medium text-[var(--fg)]">비밀번호</span>
          <input
            type="password"
            autocomplete={isSignup ? 'new-password' : 'current-password'}
            class="app-input w-full"
            placeholder={isSignup ? '6자 이상 비밀번호' : '비밀번호'}
            data-auth-password
            minlength={isSignup ? 6 : undefined}
            required
          />
        </label>
        {
          isSignup && (
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-[var(--fg)]">비밀번호 확인</span>
              <input
                type="password"
                autocomplete="new-password"
                class="app-input w-full"
                placeholder="비밀번호를 다시 입력"
                data-auth-password-confirm
                minlength={6}
                required
              />
            </label>
          )
        }
      </div>
      <button type="button" class="gsg-btn-primary mt-4 w-full !min-h-0" data-auth-email-submit>
        {submitLabel}
      </button>
    </section>

    <section class="mt-4 rounded-xl border border-[var(--card-border)] bg-[var(--surface-2)] p-4 sm:p-5">
      <h2 class="text-sm font-semibold text-[var(--fg)]">{googleSectionTitle}</h2>
      <p class="mt-1 text-xs text-[var(--fg-muted)]">{googleSectionHint}</p>
      <AuthGoogleButton label={googleLabel} />
    </section>

    <p class="app-feedback app-feedback-info mt-4" data-auth-message role="status" aria-live="polite">{message}</p>

    <p class="mt-4 text-sm text-[var(--fg-muted)]">
      {switchPrompt}
      <a href={switchHref} class="font-medium text-[var(--accent)] hover:underline">{switchLabel}</a>
    </p>
  </article>
</section>
