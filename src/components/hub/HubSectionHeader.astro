---
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props;
---

<header class:list={['hub-section-header', className]}>
  <h2 class="type-title brand-gradient-text">{title}</h2>
  {description && <p class="type-lead chrome-muted mt-3">{description}</p>}
</header>
