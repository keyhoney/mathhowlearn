---
import { STORAGE_KEYS } from '../lib/storage-keys';

interface Props {
  problemId: string;
}

const { problemId } = Astro.props;

const bookmarkBtnClass =
  'exam-focus-bookmark inline-flex min-h-[44px] shrink-0 touch-manipulation items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 type-caption font-semibold text-slate-700 hover:bg-slate-50 sm:px-4 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700';

const controlBtnClass =
  'inline-flex min-h-[44px] shrink-0 touch-manipulation items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 type-caption font-semibold text-slate-700 hover:bg-slate-50 sm:px-4 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700';
---

<section
  class="not-prose mb-4 rounded-lg border border-slate-200/80 bg-slate-50/50 px-3 py-2 dark:border-slate-700/80 dark:bg-slate-900/30 exam-focus-toolbar"
  data-focus-toolbar
  data-problem-id={problemId}
  data-focus-key={STORAGE_KEYS.FOCUS_STATE}
  data-focus-history-key={STORAGE_KEYS.FOCUS_HISTORY}
  data-bookmark-key={STORAGE_KEYS.BOOKMARK}
  role="region"
  aria-label="수능 연습·집중 모드"
>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="exam-focus-idle-only type-caption chrome-muted">
        방해 요소를 줄이고 풀이 시간을 기록합니다.
      </p>
      <span
        class="exam-focus-active-only hidden items-center gap-1.5 type-caption font-semibold text-slate-800 dark:text-slate-100 exam-focus-timer"
      >
        <svg class="h-4 w-4 shrink-0 text-indigo-600 dark:text-indigo-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 4a6 6 0 1 0 6 6 6.01 6.01 0 0 0-6-6Zm0-2a8 8 0 1 1-8 8 8 8 0 0 1 8-8Zm0 2a1 1 0 0 1 1 1v4.38l2.24 1.49a1 1 0 1 1-1.1 1.66l-2.68-1.8A1 1 0 0 1 9 10V5a1 1 0 0 1 1-1Zm-3.5-.75a.75.75 0 0 1 .75-.75h5.5a.75.75 0 0 1 0 1.5h-5.5a.75.75 0 0 1-.75-.75Z"/>
        </svg>
        <span class="tabular-nums tracking-tight" data-focus-timer>00:00</span>
      </span>
    </div>

    <div class="flex flex-wrap items-center justify-end gap-2">
      <button type="button" class={bookmarkBtnClass} data-bookmark-toggle aria-pressed="false">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-bookmark-icon>
          <path d="M6 3.75A1.75 1.75 0 0 0 4.25 5.5v10.56c0 .57.65.9 1.12.58L10 13.65l4.63 2.99c.47.31 1.12-.02 1.12-.58V5.5A1.75 1.75 0 0 0 14 3.75H6Zm-.25 1.75c0-.14.11-.25.25-.25h8c.14 0 .25.11.25.25v9.18l-3.84-2.48a.75.75 0 0 0-.82 0l-3.84 2.48V5.5Z"/>
        </svg>
        <span data-bookmark-label>스크랩</span>
      </button>

      <button
        type="button"
        class="exam-focus-idle-only inline-flex min-h-[44px] w-full shrink-0 touch-manipulation items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 type-caption font-semibold text-white shadow-sm hover:bg-indigo-700 sm:w-auto dark:bg-indigo-500 dark:hover:bg-indigo-400"
        data-focus-toggle
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 3a1 1 0 0 1 1 1v1.09a4.99 4.99 0 0 1 3.91 3.91H16a1 1 0 1 1 0 2h-1.09a4.99 4.99 0 0 1-3.91 3.91V16a1 1 0 1 1-2 0v-1.09A4.99 4.99 0 0 1 5.09 11H4a1 1 0 1 1 0-2h1.09A4.99 4.99 0 0 1 9 5.09V4a1 1 0 0 1 1-1Zm0 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/>
        </svg>
        <span data-focus-toggle-label>집중 모드 켜기</span>
      </button>

      <button type="button" class:list={[controlBtnClass, 'exam-focus-active-only', 'hidden']} data-focus-pause hidden>
        일시정지
      </button>
      <button type="button" class:list={[controlBtnClass, 'exam-focus-active-only', 'hidden']} data-focus-resume hidden>
        재개
      </button>
      <button
        type="button"
        class="exam-focus-active-only hidden min-h-[44px] shrink-0 touch-manipulation rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 type-caption font-semibold text-slate-700 hover:bg-slate-200 sm:px-4 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        data-focus-stop
      >
        모드 끄기
      </button>
    </div>
  </div>
</section>

<script>
  import '../lib/client/focus-toolbar';
</script>

<style>
  body.exam-focus-active .exam-focus-toolbar {
    position: sticky;
    top: 0;
    z-index: 40;
    margin-left: -1rem;
    margin-right: -1rem;
    border-style: solid;
    border-bottom-color: rgb(226 232 240 / 0.9);
    background: rgb(248 250 252 / 0.95);
    padding-left: 1rem;
    padding-right: 1rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    backdrop-filter: blur(12px);
  }

  :global(html.dark) body.exam-focus-active .exam-focus-toolbar {
    border-bottom-color: rgb(51 65 85);
    background: rgb(2 6 23 / 0.9);
  }

  body.exam-focus-active .exam-focus-toolbar .exam-focus-idle-only {
    display: none !important;
  }

  body.exam-focus-active .exam-focus-toolbar .exam-focus-active-only {
    display: inline-flex !important;
  }

  .exam-focus-toolbar .exam-focus-active-only {
    display: none;
  }

  :global([data-bookmark-toggle].is-active [data-bookmark-icon]) {
    color: #059669;
    fill: #059669;
  }

  :global(html.dark [data-bookmark-toggle].is-active [data-bookmark-icon]) {
    color: #34d399;
    fill: #34d399;
  }

  :global([data-bookmark-toggle].is-active) {
    border-color: rgb(16 185 129 / 0.45);
    color: #047857;
  }

  :global(html.dark [data-bookmark-toggle].is-active) {
    border-color: rgb(52 211 153 / 0.45);
    color: #6ee7b7;
  }
</style>
