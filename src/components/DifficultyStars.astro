---
interface Props {
  value: number;
}

const { value } = Astro.props;
const n = Math.min(5, Math.max(0, Math.round(Number(value) || 0)));
---

<span
  class="type-overline inline-flex items-center gap-0.5 bg-orange-50 text-orange-700 px-2 py-0.5 rounded normal-case tracking-normal font-bold dark:bg-orange-950/40 dark:text-orange-300"
  aria-label={`난이도 ${n}단계, 최대 5단계`}
>
  난이도
  <span class="flex ml-0.5" aria-hidden="true">
    {
      [0, 1, 2, 3, 4].map((i) => (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class={`h-3 w-3 ${i < n ? 'fill-orange-400 text-orange-400' : 'text-orange-200 dark:text-orange-900/50'}`}
        >
          <path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
      ))
    }
  </span>
</span>
