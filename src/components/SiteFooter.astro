---
import { CONTENT_SITE_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
const ADMIN_UID_ALLOWLIST = String(import.meta.env.PUBLIC_ADMIN_UID_ALLOWLIST || '')
  .split(',')
  .map((item) => item.trim())
  .filter(Boolean);

const learningLinks = [
  { href: '/problems', label: '수능 기출' },
  { href: '/dashboard', label: '대시보드' },
  { href: '/problems/wrong-note', label: '오답 노트' },
  { href: '/problems/bookmarks', label: '스크랩' },
  { href: '/problems/concept-frequency', label: '출제 경향' },
];

const utilityLinks = [
  { href: '/search', label: '검색' },
  { href: CONTENT_SITE_URL, label: '학습 가이드', external: true },
  { href: '/about', label: '소개' },
  { href: '/privacy', label: '개인정보' },
  { href: '/terms', label: '이용약관' },
  { href: '/contact', label: '문의' },
];

const accountLinks = [
  { href: '/login', label: '로그인' },
  { href: '/signup', label: '회원가입' },
];

const footerLinkClass = 'hover:text-slate-700 dark:hover:text-slate-200';
const footerListClass = 'space-y-1.5 text-xs chrome-muted';
const footerHeadingClass =
  'mb-3 text-xs font-semibold uppercase tracking-wide text-slate-700 dark:text-slate-300';
---

<footer
  id="app-site-footer"
  data-admin-uid-allowlist={ADMIN_UID_ALLOWLIST.join(',')}
  class="mt-8 w-full border-t border-[var(--card-border)] bg-[color-mix(in_srgb,var(--surface-2)_70%,transparent)] py-5 sm:mt-12 sm:py-10"
>
  <div class="book-nav-inner mx-auto max-w-[72rem] pb-[max(0,env(safe-area-inset-bottom))]">
    <!-- 모바일: 접이식 -->
    <div class="space-y-2 md:hidden">
      <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">{SITE_TITLE}</p>

      <details class="site-footer-details">
        <summary>학습</summary>
        <ul class="site-footer-details__links">
          {learningLinks.map((link) => (
            <li>
              <a href={link.href} class={footerLinkClass}>{link.label}</a>
            </li>
          ))}
        </ul>
      </details>

      <details class="site-footer-details">
        <summary>정보</summary>
        <ul class="site-footer-details__links site-footer-details__links--grid">
          {utilityLinks.map((link) => (
            <li>
              {link.external ? (
                <a href={link.href} class={footerLinkClass} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ) : (
                <a href={link.href} class={footerLinkClass}>{link.label}</a>
              )}
            </li>
          ))}
          {accountLinks.map((link) => (
            <li>
              <a href={link.href} class={footerLinkClass}>{link.label}</a>
            </li>
          ))}
          <li class="hidden" data-admin-only-link>
            <a href="/admin/sync-usage" class={footerLinkClass}>운영 지표</a>
          </li>
        </ul>
      </details>
    </div>

    <!-- PC: 3단 -->
    <div class="hidden md:grid md:grid-cols-3 md:items-start md:gap-10 lg:gap-16">
      <div class="min-w-0 pr-4">
        <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">{SITE_TITLE}</p>
        <p class="mt-3 max-w-sm type-caption leading-relaxed chrome-muted">{SITE_DESCRIPTION}</p>
      </div>

      <div>
        <h3 class={footerHeadingClass}>학습</h3>
        <ul class={footerListClass}>
          {learningLinks.map((link) => (
            <li>
              <a href={link.href} class={footerLinkClass}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class={footerHeadingClass}>정보</h3>
        <ul class={footerListClass}>
          {utilityLinks.map((link) => (
            <li>
              {link.external ? (
                <a href={link.href} class={footerLinkClass} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ) : (
                <a href={link.href} class={footerLinkClass}>{link.label}</a>
              )}
            </li>
          ))}
          <li class="hidden" data-admin-only-link>
            <a href="/admin/sync-usage" class={footerLinkClass}>운영 지표</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="book-nav-inner mx-auto mt-4 max-w-[72rem] border-t border-slate-200/80 pt-3 text-center type-caption chrome-muted sm:mt-6 sm:pt-4 dark:border-slate-800/80">
    © {year} {SITE_TITLE}
  </div>
</footer>
{ADMIN_UID_ALLOWLIST.length > 0 && (
  <script>
    import { scheduleFooterAdminLinkCheck } from '../lib/client/footer-admin-link';
    scheduleFooterAdminLinkCheck();
  </script>
)}
